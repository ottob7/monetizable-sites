{
  "scripts": {
    "test": "node tests/site-check.mjs",
    "build": "node scripts/build.mjs",
    "dev:air": "cd sites/can-i-breathe-today && python3 -m http.server 4173",
    "dev:verse": "cd sites/versewise && python3 -m http.server 4174",
    "deploy:air:preview": "node scripts/deploy-vercel.mjs can-i-breathe-today",
    "deploy:air:prod": "node scripts/deploy-vercel.mjs can-i-breathe-today --prod",
    "deploy:verse:preview": "node scripts/deploy-vercel.mjs versewise",
    "deploy:verse:prod": "node scripts/deploy-vercel.mjs versewise --prod",
    "deploy:recommended": "npm run deploy:air:prod && npm run deploy:verse:prod"
  },
  "devDependencies": {
    "vercel": "^53.4.0"
  },
  "private": true
}
